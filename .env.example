# Copy this file to .env for local development, or configure the same values in Vercel.
# DATABASE_PATH is for local development only. Vercel requires a managed persistent database
# before account, conversation, usage, payment, and announcement data can be production-safe.
APP_URL=https://theguiderai.dpdns.org
# Register this exact URL in Google Cloud Console > Authorized redirect URIs.
GOOGLE_REDIRECT_URI=https://theguiderai.dpdns.org/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OWNER_EMAIL=
OWNER_PASSWORD=
DATABASE_PATH=
TG_PRODUCTION_URL=
