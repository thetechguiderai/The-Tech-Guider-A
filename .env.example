# Public site URL used as the Google OAuth callback base.
APP_URL=https://your-domain.com

# Create these in Google Cloud Console > APIs & Services > Credentials.
# Add ${APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required application settings.
SESSION_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
